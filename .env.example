# Cloud project values: Project URL + Publishable key from the Supabase Connect dialog.
# For local development, use the API URL + publishable key printed by `npm run supabase:status`.
#
# The publishable key is safe to ship in a browser bundle. Never put a Supabase
# secret key (sb_secret_...) or a legacy service_role key in a VITE_ variable.
#
# The Kilo API key for CV fit analysis is server-only. Configure it as a Supabase
# Edge Function secret (see supabase/functions/.env.example), never here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Local-only account recreated by `npm run supabase:reset`. These are not exposed
# to the browser and must never be used for the cloud project.
LOCAL_USER_EMAIL=dev@example.com
LOCAL_USER_PASSWORD=change-this-local-password
LOCAL_USER_NAME=Local Dev
