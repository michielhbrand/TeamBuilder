{
  "name": "teambuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "prebuild-only": "node scripts/copy-ocr-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "type-check": "npm run typecheck",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "validate:env": "node scripts/validate-env.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:push": "supabase db push --remote"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@supabase/supabase-js": "^2.118.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "compress-pdf-lib": "^1.0.5",
    "pdfjs-dist": "^6.5.438",
    "pinia": "^4.0.3",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "semantic-release": "^25.0.9",
    "supabase": "^3.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "license": "Apache-2.0",
  "description": "Vue 3 + Supabase hiring pipeline workspace deployed to GitHub Pages",
  "repository": {
    "type": "git",
    "url": "https://github.com/michielhbrand/TeamBuilder.git"
  },
  "homepage": "https://michielhbrand.github.io/TeamBuilder/",
  "bugs": {
    "url": "https://github.com/michielhbrand/TeamBuilder/issues"
  }
}
