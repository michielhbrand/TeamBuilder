# Supabase Edge Function secrets for fit-analysis.
# Copy to supabase/functions/.env for local function serving. Never commit real values.
#
# KILO_API_KEY is a server-side secret. It must never be a VITE_ variable,
# committed, or injected into the browser build.
KILO_API_KEY=
# Must be a free model, for example a model id ending in :free.
KILO_MODEL=kilo-auto/free
# Set to false to disable the function without removing secrets.
FIT_ANALYSIS_ENABLED=true
